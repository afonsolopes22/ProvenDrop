# Segredos das Edge Functions. NUNCA colocar valores reais neste ficheiro nem no
# repositório. O caminho normal é scripts/setup-supabase.ps1, que pede os valores
# sem eco, escreve-os num .env temporário só legível pelo utilizador, corre
# `supabase secrets set --env-file` e apaga-o. SUPABASE_URL e
# SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo Supabase.

# Stripe — começar SEMPRE em modo de teste (sk_test_…, whsec_… do endpoint de teste)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "1" = a função só aceita eventos de teste (livemode=false); vazio/"0" = só eventos
# reais. O setup define-o a partir do prefixo da chave (sk_test_ → 1).
STRIPE_ACCEPT_TEST=
# price_… mensal do produto "ProvenDrop Direct" e do produto da Click: é por aqui
# que o webhook sabe a origem quando o link não traz metadata "origem". Os ids de
# teste estão no vault ("Stripe — modo de teste"); os reais criam-se no modo real.
STRIPE_PRICE_DIRETO=
STRIPE_PRICE_CLICK=
# opcional: id (plink_…) do Payment Link direto, mais um sinal de origem
STRIPE_PAYMENT_LINK_DIRETO=

# E-mail (Resend) — o domínio de envio tem de estar verificado no Resend
# (sem domínio: EMAIL_FROM="ProvenDrop <onboarding@resend.dev>", só entrega ao e-mail da conta)
RESEND_API_KEY=
EMAIL_FROM="ProvenDrop <noreply@provendrop.com>"
EMAIL_REPLY_TO=
# Alertas operacionais (duplicados, disputas, reembolsos, reconciliação, boas-vindas falhadas)
# e "New Click subscription" (nome, telefone, e-mail, código PD-XXXXXX) a cada compra do plano Click.
# Vazio = usa EMAIL_REPLY_TO.
ALERT_EMAIL=

# Área pessoal (tem de constar em Authentication → URL Configuration → Redirect URLs)
APP_URL=https://provendrop.com/app.html

# Hora de envio do e-mail diário (Europe/Lisbon, 0–23): igual a DAILY_TIME do config.js
HORA_ENVIO=9
# validade do magic link em minutos (igual a Authentication → Email OTP expiration)
MAGIC_LINK_MINUTOS=60

# Segredo partilhado entre o pg_cron (public.config.cron_secret) e as funções
CRON_SECRET=
