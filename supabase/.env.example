# Segredos das Edge Functions. NUNCA colocar valores reais neste ficheiro nem no
# repositório. O caminho normal é scripts/setup-supabase.ps1, que pede os valores
# e corre `supabase secrets set` sem os gravar em disco. Alternativa manual:
# copiar para supabase/.env (ignorado pelo git) e correr
#   supabase secrets set --env-file supabase/.env
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente.

# Stripe — começar SEMPRE em modo de teste (sk_test_…, whsec_… do endpoint de teste)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# price_… do preço mensal do produto "ProvenDrop Direct" e do produto da Click:
# é por aqui que o webhook sabe a origem quando o link não traz metadata "origem".
STRIPE_PRICE_DIRETO=
STRIPE_PRICE_CLICK=
# opcional: id (plink_…) do Payment Link direto, mais um sinal de origem
STRIPE_PAYMENT_LINK_DIRETO=

# E-mail (Resend) — o domínio de envio tem de estar verificado no Resend
RESEND_API_KEY=
EMAIL_FROM="ProvenDrop <noreply@EXEMPLO.pt>"
EMAIL_REPLY_TO=

# Área pessoal (tem de constar em Authentication → URL Configuration → Redirect URLs)
APP_URL=https://afonsolopes22.github.io/ProvenDrop/app.html

# Hora de envio do e-mail diário (Europe/Lisbon, 0–23): igual a DAILY_TIME do config.js
HORA_ENVIO=9
# validade do magic link em minutos (igual a Authentication → Email OTP expiration)
MAGIC_LINK_MINUTOS=60

# Segredo partilhado entre o pg_cron (public.config.cron_secret) e a função email-diario
CRON_SECRET=
